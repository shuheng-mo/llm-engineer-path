# 阿里云通义千问（课程默认 LLM provider）
DASHSCOPE_API_KEY=your_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL_NAME=qwen-max

# LangSmith 追踪（可选）
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langchain_course

# 多 Provider（可选）
OPENAI_API_KEY=
ClAUDE_API_KEY=
GOOGLE_API_KEY=
DeepseekAPI_BASE_URL=

# 第七章 — Redis 短期记忆 + Postgres 长期画像
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=15

PG_HOST=localhost
PG_PORT=5432
PG_DB=langchain_course
PG_USER=postgres
PG_PASSWORD=

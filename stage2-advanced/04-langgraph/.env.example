# 阿里云通义千问（课程默认 LLM provider）
DASHSCOPE_API_KEY=your_api_key_here

# Qwen 兼容 OpenAI 协议的端点（持久化模块用 ChatOpenAI 时需要）
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=your_api_key_here
QWEN_MODEL_NLP=qwen-max

# LangSmith 追踪（可选）
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Langgraph_test

# Postgres Checkpointer / Store
DB_URI=postgresql://user:pass@localhost:5432/langgraph

# Redis Checkpointer
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Tavily 搜索（模块五研报助手）
TAVILY_API_KEY=
